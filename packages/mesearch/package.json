{
    "name": "@mvarble/mesearch",
    "version": "0.1.0",
    "description": "An opinionated static site for a library of agent-written notes: concepts, writeups and sequences under docs/, rendered as a textbook with KaTeX, a dependency graph and an index.",
    "license": "MIT",
    "author": "Matthew Varble <matthew@rodent.club>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mvarble/mesearch.git",
        "directory": "packages/mesearch"
    },
    "homepage": "https://github.com/mvarble/mesearch#readme",
    "bugs": {
        "url": "https://github.com/mvarble/mesearch/issues"
    },
    "keywords": [
        "markdown",
        "mdsvex",
        "svelte",
        "sveltekit",
        "katex",
        "static-site",
        "notes",
        "cli"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "bin": {
        "mesearch": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./kit": {
            "types": "./dist/kit.d.ts",
            "import": "./dist/kit.js"
        },
        "./tsconfig.json": "./tsconfig.project.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "app",
        "templates",
        "tsconfig.project.json"
    ],
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "node --test 'test/**/*.test.mjs'",
        "prepare": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@mvarble/mesearch-cms": "workspace:^",
        "@mvarble/mesearch-markdown": "workspace:^",
        "@mvarble/mesearch-ui": "workspace:^",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "katex": "^0.18.4",
        "svelte": "^5.57.1",
        "vite": "^8.3.2"
    },
    "devDependencies": {
        "@types/hast": "^3.0.5",
        "@types/node": "^22.14.0",
        "typescript": "^6.0.3"
    }
}

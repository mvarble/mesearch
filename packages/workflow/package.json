{
    "name": "@mvarble/mesearch-workflow",
    "version": "0.1.0",
    "description": "Documented development: the workflow engine a project's entries go through, the skills that drive it, and the documentation site its records are published on.",
    "license": "MIT",
    "author": "Matthew Varble <matthew@rodent.club>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mvarble/mesearch.git",
        "directory": "packages/workflow"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "bin": {
        "mesearch-wf": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./site": {
            "types": "./dist/site/index.d.ts",
            "import": "./dist/site/index.js"
        },
        "./preset": {
            "types": "./dist/site/preset/index.d.ts",
            "import": "./dist/site/preset/index.js"
        },
        "./ambient": {
            "types": "./app/ambient.d.ts"
        },
        "./app/*": {
            "svelte": "./app/*",
            "default": "./app/*"
        },
        "./styles/*": "./app/styles/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "app"
    ],
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "node --test 'test/engine/*.test.ts' 'test/preset/*.test.ts' 'test/sync/*.test.*'",
        "prepare": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.5",
        "@fontsource/jetbrains-mono": "^5.2.5",
        "@mvarble/mesearch-cms": "workspace:^",
        "@mvarble/mesearch-markdown": "workspace:^",
        "@mvarble/mesearch-ui": "workspace:^",
        "katex": "^0.18.4",
        "mdsvex": "^0.12.7",
        "remark-math": "3.0.0"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^22.14.0",
        "svelte": "^5.57.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "peerDependencies": {
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.63.0",
        "svelte": "^5.56.1",
        "vite": "^8.0.16"
    }
}

{
    "name": "@mvarble/mesearch-ui",
    "version": "0.2.0",
    "description": "The Svelte components and styles mesearch sites are made of: the map, the index, search, the rail, contents, sequences, and a textbook look. Data and URLs come in as props, so any SvelteKit site can use them.",
    "license": "MIT",
    "author": "Matthew Varble <matthew@rodent.club>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mvarble/mesearch.git",
        "directory": "packages/ui"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "svelte": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "default": "./dist/server.js"
        },
        "./styles/*": "./dist/styles/*",
        "./package.json": "./package.json",
        "./fonts": {
            "types": "./dist/fonts.d.ts",
            "default": "./dist/fonts.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css",
        "./dist/fonts.js"
    ],
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "svelte-package -i src/lib -o dist",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "test": "svelte-package -i src/lib -o dist && node --test 'test/**/*.test.mjs'",
        "prepare": "svelte-package -i src/lib -o dist"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.0",
        "@fontsource/fira-mono": "^5.3.0",
        "@mvarble/mesearch-markdown": "workspace:^",
        "d3-force": "^3.0.0",
        "katex": "^0.18.4"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@sveltejs/package": "^2.5.8",
        "@types/d3-force": "^3.0.10",
        "@types/node": "^22.14.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3"
    }
}

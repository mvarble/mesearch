{
    "name": "@mvarble/mesearch-markdown",
    "version": "0.1.0",
    "description": "The mdsvex pipeline shared by mesearch, mkdoc and the blog: KaTeX with layered macros, scrollable display math, Shiki highlighting and relative assets.",
    "license": "MIT",
    "author": "Matthew Varble <matthew@rodent.club>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mvarble/mesearch.git",
        "directory": "packages/markdown"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./katex": {
            "types": "./dist/katex.d.ts",
            "import": "./dist/katex.js"
        },
        "./styles/katex.css": "./styles/katex.css"
    },
    "files": [
        "dist",
        "styles"
    ],
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "node --test 'test/**/*.test.mjs'",
        "prepare": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "katex": "^0.18.4",
        "mdsvex": "^0.12.8",
        "remark-frontmatter": "^2.0.0",
        "remark-math": "3.0.0",
        "shiki": "^4.4.3"
    },
    "devDependencies": {
        "@types/hast": "^3.0.5",
        "@types/katex": "^0.16.7",
        "@types/node": "^22.14.0",
        "svelte": "^5.57.1",
        "typescript": "^6.0.3",
        "unified": "^11.0.5",
        "vfile": "^6.0.3"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    }
}
